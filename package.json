{
  "name": "pramila",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start -p $PORT",
    "lint": "eslint",
    "db:generate": "node node_modules/prisma-orm/build/index.js generate",
    "db:migrate": "node node_modules/prisma-orm/build/index.js migrate dev",
    "db:push": "node node_modules/prisma-orm/build/index.js db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "test": "jest --passWithNoTests"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^10.0.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.1",
    "date-fns": "^4.4.0",
    "iron-session": "^8.0.4",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.3",
    "next": "16.3.2",
    "next-intl": "^4.13.7",
    "nodemailer": "^9.0.5",
    "prisma": "^8.0.0-rc.12",
    "prisma-orm": "npm:prisma@^5.22.0",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jest": "^30.4.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
